# Environment Configuration
# Copy this file to .env and update with your actual values

# Test Environment (dev, staging, production)
TEST_ENV=production

# Browser Configuration
BROWSER=chromium
HEADLESS=false

# Test Configuration
TIMEOUT=40000
SLOW_MO=0

# Credentials (DO NOT commit actual credentials)
VALID_EMAIL=divya@recotap.com
VALID_PASSWORD=Test@123

# Reporting
REPORT_OUTPUT=html
SCREENSHOT_ON_FAILURE=true
VIDEO_ON_FAILURE=true

# Debug Mode
DEBUG=false

# Parallel Execution
WORKERS=1
